# Copia este archivo como .env.<entorno> (por ejemplo .env.dev o .env.qa) y completa los valores.
# El entorno se elige al ejecutar con TEST_ENV (por defecto: dev).
# Solo este archivo de ejemplo se sube al repositorio; los .env reales quedan en local.

# URL base de la aplicación para el entorno seleccionado.
BASE_URL=https://www.saucedemo.com

# Credenciales del usuario de prueba. Son los usuarios demo públicos de SauceDemo;
# nunca subas credenciales reales.
SAUCE_USERNAME=standard_user
SAUCE_PASSWORD=secret_sauce
